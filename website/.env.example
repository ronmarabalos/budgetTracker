# Download links shown on the website. Leave a value empty and that button shows “Coming soon”.
# Copy to `.env` (or set these in your hosting provider's build settings).

# iOS — App Store listing, e.g. https://apps.apple.com/app/id0000000000
VITE_IOS_APP_STORE_URL=
# iOS beta — public TestFlight link, e.g. https://testflight.apple.com/join/XXXXXXXX (used until the App Store link exists)
VITE_IOS_TESTFLIGHT_URL=

# Android — Google Play listing, e.g. https://play.google.com/store/apps/details?id=com.budgettrack.app
VITE_ANDROID_PLAY_STORE_URL=
# Android — direct APK download (e.g. an EAS build URL or a GitHub release asset)
VITE_ANDROID_APK_URL=
# Optional: SHA-256 of that APK, shown so people can verify their download
VITE_ANDROID_APK_SHA256=
# Optional: APK download size shown on the button, e.g. 134 MB
VITE_ANDROID_APK_SIZE=
# Optional: version label shown next to the downloads, e.g. 1.0.0
VITE_APP_VERSION=

# Contact address shown in the privacy policy (app stores require a way to contact you)
VITE_CONTACT_EMAIL=

# Jurisdiction named in the Terms of Service (default: the Republic of the Philippines)
VITE_GOVERNING_LAW=
